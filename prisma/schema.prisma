generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Comment {
  id        String   @id @default(cuid())
  slug      String
  nickname  String
  body      String
  deviceId  String?
  parentId  String?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime @default(now())

  @@index([slug, createdAt])
  @@index([slug, parentId, createdAt])
}

model Upvote {
  id          String   @id @default(cuid())
  slug        String
  deviceId    String
  legacyScore Int      @default(1) @map("score")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([slug, deviceId])
  @@index([slug])
  @@map("Rating")
}

model LinkSubmission {
  id             String   @id @default(cuid())
  url            String   @unique
  note           String
  category       String?
  submitterName  String?
  submitterEmail String?
  status         String   @default("pending")
  reviewerNote   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
}

model ResourceSubmission {
  id             String   @id @default(cuid())
  url            String   @unique
  name           String
  description    String
  category       String
  submitterName  String?
  submitterEmail String?
  status         String   @default("pending")
  reviewerNote   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
}

model NewsletterSubscriber {
  id                    String    @id @default(cuid())
  email                 String    @unique
  status                String    @default("pending")
  confirmationTokenHash  String?   @unique
  consentAt             DateTime  @default(now())
  confirmedAt           DateTime?
  unsubscribedAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status, createdAt])
}

model ArticleView {
  id        String   @id @default(cuid())
  slug      String
  viewerId  String
  createdAt DateTime @default(now())

  @@unique([slug, viewerId])
  @@index([slug])
}

model SlackInstallation {
  id                  String   @id @default(cuid())
  teamId              String   @unique
  teamName            String?
  botTokenEncrypted   String
  channelId           String?
  channelName         String?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deliveries          SlackDelivery[]

  @@index([active])
}

model SlackDelivery {
  id             String            @id @default(cuid())
  installationId String
  slug           String
  status         String            @default("pending")
  claimToken     String?
  claimedAt      DateTime          @default(now())
  sentAt         DateTime?
  installation   SlackInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@unique([installationId, slug])
  @@index([status, claimedAt])
}
