# 댓글/별점용 Postgres 연결 문자열 (Neon, Supabase, Vercel Postgres 등).
# 설정하지 않으면 사이트는 정상 동작하고 댓글/별점만 "준비 중"으로 표시된다.
# Vercel에서 Storage → Neon을 연결하면 자동으로 등록되므로 직접 설정할 일은
# 로컬에서 실제 DB를 붙여 테스트할 때뿐이다.
# DATABASE_URL="postgresql://user:***@host/dbname?sslmode=require"

# Slack Bot (공개 Add to Slack 설치)
# SLACK_CLIENT_ID="1234567890.1234567890"
# SLACK_CLIENT_SECRET="***"
# SLACK_REDIRECT_URI="https://crit.day/api/slack/oauth/callback"
# 32바이트 랜덤 키를 base64로 저장한다.
# SLACK_TOKEN_ENCRYPTION_KEY="***"
# GitHub Actions가 /api/slack/digest를 호출할 때 사용하는 별도 비밀값.
# SLACK_CRON_SECRET="***"

# 일일 Slack 리포트용 Vercel Web Analytics API.
# Vercel Dashboard에서 Web Analytics를 활성화하고 access token을 만든다.
# VERCEL_ANALYTICS_TOKEN="..."
# VERCEL_ANALYTICS_PROJECT_ID="prj_..."
# 팀 프로젝트이면 팀 ID도 설정한다.
# VERCEL_ANALYTICS_TEAM_ID="team_..."
